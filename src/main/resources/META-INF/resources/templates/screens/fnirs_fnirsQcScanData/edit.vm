<!-- BEGIN fnirs:fnirsQcScanData -->
#set($imageScan_ID = $item.getStringProperty("fnirs:fnirsqcData/scans/scan[$scan_counter]/imageScan_ID"))
#xdatHiddenBox("fnirs:fnirsqcData/scans/scan[$scan_counter][@xsi:type=fnirs:fnirsQcScanData]/imageScan_ID" $item $imageScan_ID)

<table cellspacing="10" border="0">
    <tr valign="top">
        <td width="330">
            <h4>Snapshots</h4>
            <div class="snapshot-grid-container"></div>
            <script>
                XNAT.app.showFnirsQcImages('${imageSession_ID}','${imageScan_ID}');
            </script>
        </td>
        <td width="330">
            <h4>Measurements</h4>
            <div class="fnirs-measurements $scanId"></div>
            #xdatHiddenBox("fnirs:fnirsqcData/scans/scan[$scan_counter][@xsi:type=fnirs:fnirsQcScanData]/percentGm" $item "")
            #xdatHiddenBox("fnirs:fnirsqcData/scans/scan[$scan_counter][@xsi:type=fnirs:fnirsQcScanData]/medSnrRsd" $item "")
            #xdatHiddenBox("fnirs:fnirsqcData/scans/scan[$scan_counter][@xsi:type=fnirs:fnirsQcScanData]/medGvtd" $item "")
            <script>
                XNAT.app.showFnirsQcMeasurements('${imageSession_ID}','${imageScan_ID}','${scan_counter}');
            </script>
        </td>
        <td width="330">
            <h4>Quality Assessments</h4>
            #qcEnumeratedRating("fnirs:fnirsqcData/scans/scan[$scan_counter][@xsi:type=fnirs:fnirsQcScanData]/lightFalloff" "Light Fall Off" $item $vr)
            #qcEnumeratedRating("fnirs:fnirsqcData/scans/scan[$scan_counter][@xsi:type=fnirs:fnirsQcScanData]/pulseSnr" "Pulse SNR" $item $vr)
            #qcEnumeratedRating("fnirs:fnirsqcData/scans/scan[$scan_counter][@xsi:type=fnirs:fnirsQcScanData]/pulsatility" "Pulsatility" $item $vr)
            #qcEnumeratedRating("fnirs:fnirsqcData/scans/scan[$scan_counter][@xsi:type=fnirs:fnirsQcScanData]/motion" "Motion" $item $vr)
            #qcYesNoSelect("fnirs:fnirsqcData/scans/scan[$scan_counter][@xsi:type=fnirs:fnirsQcScanData]/pass" "Pass QC?" $item $vr)
            #xdatHiddenBox("fnirs:fnirsqcData/scans/scan[$scan_counter][@xsi:type=fnirs:fnirsQcScanData]/xnat_qcScanData_id" $item "")
            #qcCommentBox("fnirs:fnirsqcData/scans/scan[$scan_counter][@xsi:type=fnirs:fnirsQcScanData]/comments" $item $vr)
        </td>
    </tr>
</table>


<!-- END fnirs:fnirsQcScanData -->

