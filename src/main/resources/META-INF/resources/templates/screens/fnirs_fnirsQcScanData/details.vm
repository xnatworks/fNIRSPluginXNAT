<tr>
	<th>Pass</th>
	<td style="font-weight:bold;">
		#if ($!scan.getStringProperty("fnirs:fnirsQcScanData/pass").equals("1"))
			<span style="color:green">Passed</span>
		#elseif($!scan.getStringProperty("fnirs:fnirsQcScanData/pass").equals("0"))
			<span style="color:red">Failed</span>
		#else
			<span style="color:gold">Unknown ($!scan.getStringProperty("fnirs:fnirsQcScanData/pass")</span>
		#end
	</td>
</tr>
<tr>
    <th>Light Fall Off</th>
    <td>$!scan.getStringProperty("fnirs:fnirsQcScanData/lightFalloff")</td>
</tr>
<tr>
    <th>Pulse SNR</th>
    <td>$!scan.getStringProperty("fnirs:fnirsQcScanData/pulseSnr")</td>
</tr>
<tr>
    <th>Pulsatility</th>
    <td>$!scan.getStringProperty("fnirs:fnirsQcScanData/pulsatility")</td>
</tr>
<tr>
    <th>Motion</th>
    <td>$!scan.getStringProperty("fnirs:fnirsQcScanData/motion")</td>
</tr>
<tr>
    <th>Map Quality</th>
    <td>$!scan.getStringProperty("fnirs:fnirsQcScanData/mapQuality")</td>
</tr>


#if( $!scan.getStringProperty("fnirs:fnirsQcScanData/comments") )
	<tr><th>Additional QC Comments</th><td>$!scan.getStringProperty("fnirs:fnirsQcScanData/comments")</td></tr>
#end
