#set($imageScan_ID = $item.getStringProperty("fnirs:fnirsqcData/scans/scan[$scan_counter]/imageScan_ID"))

<table cellspacing="10" border="0">
    <tr valign="top">
        <td width="330">
            <h4>Snapshots</h4>
            <div class="snapshot-grid-container"></div>
            <script>
                XNAT.app.showFnirsQcImages('${imageSession_ID}','${scanId}');
            </script>
        </td>
        <td width="330">
            <h4>Measurements</h4>
            <div class="fnirs-measurements $scanId"></div>
            <script>
                XNAT.app.showFnirsQcMeasurements('${imageSession_ID}','${scanId}');
            </script>
        </td>
        <td width="330">
            <h4>Quality Assessments</h4>
            <div class="panel-element">
                <label class="element-label" for="$name">Pass</label>
                <div class="element-wrapper">
                    #if ($!scan.getStringProperty("xnat:qcScanData/pass").equals("1"))
                        Pass
                    #else
                        Fail
                    #end
                </div>
                <div class="clear"></div>
            </div>
            #showQcMeasurement("fnirs:fnirsQcScanData/lightFalloff" "Light Fall Off" $scan)
            #showQcMeasurement("fnirs:fnirsQcScanData/pulseSnr" "Pulse SNR" $scan)
            #showQcMeasurement("fnirs:fnirsQcScanData/pulsatility" "Pulsatility" $scan)
            #showQcMeasurement("fnirs:fnirsQcScanData/motion" "Motion" $scan)
            #showQcMeasurement("fnirs:fnirsQcScanData/comments" "Scan Comments" $scan)
        </td>
    </tr>
</table>
