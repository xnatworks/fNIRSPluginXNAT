#macro (qcYesNo $name $qcItem)
	#if ($qcItem.getStringProperty($name) == "1")
		Yes
	#elseif ($qcItem.getStringProperty($name) == "0")
		No
	#else
		$!qcItem.getStringProperty($name)
	#end
#end

#parse($turbineUtils.getTemplateName("report","xnat:imageAssessorData",$project))

<script type="text/javascript">
	document.title = "fNIRS QC Assessment for $!mr.getIdentifier($project,false)";
</script>

<link rel="stylesheet" type="text/css" href="$content.getURI("/style/fnirs.css")" />

<h2>Overall QC for $!mr.getIdentifier($project,false)</h2>
<table class="qcSessionTable">
	#if( $item.getProperty("fnirs:fnirsqcData/rater") )
		<tr><th>Rater</th><td>$!item.getStringProperty("fnirs:fnirsqcData/rater")</td></tr>
	#end
	#if( $item.getProperty("fnirs:fnirsqcData/comments") )
		<tr><th>Comments</th><td>$!item.getStringProperty("fnirs:fnirsqcData/comments")</td></tr>
	#end
</table>
<script type="application/javascript" src="$content.getURI("/scripts/xnat/plugin/fnirs/fnirs-qc.js")"></script>

#set($imageSession_ID = $item.getStringProperty("fnirs:fnirsqcData/imageSession_ID"))
#set ($scans = $om.getScans_scan())
#if ($scans && $scans.size() > 0)
	<h2>Scans</h2>
	<table class="qcScanTable">
		#foreach($scan in $scans)
			#set($scanId=$!scan.getStringProperty("xnat:qcScanData/imageScan_ID"))
			<tr>
				<td>
				    <div class="report-section $!scanId">
                        <h3>Scan $!scanId</h3>
                        <div class="snapshot-grid-container"></div>
                        <script>
                            XNAT.app.showFnirsQcImages('${imageSession_ID}','${scanId}');
                        </script>

                        <table>
                            #parse($turbineUtils.getTemplateName("details",$scan.getXSIType(),$project))
                        </table>
                    </div>
				</td>
			</tr>
		#end
	</table>
#end
