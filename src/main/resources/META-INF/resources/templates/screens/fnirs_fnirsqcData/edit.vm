<script type="text/javascript" LANGUAGE="javascript" src="$content.getURI('scripts/subjectAssessorData/proj_tools.js')"></script>

#set ($imageSessionType = $om.getImageSessionData().getXSIType())

#macro (qcEnumeratedRating $name $label $qcItem $vr)
	<div class="panel-element #if($vr) #if($vr.getField($name)) invalid #end #end">
        <label class="element-label" for="$name">$label</label>
        <div class="element-wrapper">
            <label>
                <select name="$name">
                    <option value="0" #if($qcItem.getStringProperty($name) == "0") selected #end>Select A Rating</option>
                    <option value="1" #if($qcItem.getStringProperty($name) == "1") selected #end>1</option>
                    <option value="2" #if($qcItem.getStringProperty($name) == "2") selected #end>2</option>
                    <option value="3" #if($qcItem.getStringProperty($name) == "3") selected #end>3</option>
                    <option value="4" #if($qcItem.getStringProperty($name) == "4") selected #end>4</option>
                    <option value="5" #if($qcItem.getStringProperty($name) == "5") selected #end>5</option>
                </select>
            </label>
        </div>
        <div class="clear"></div>
    </div>
#end

#macro (qcYesNoSelect $name $label $qcItem $vr)
	<div class="panel-element #if($vr) #if($vr.getField($name)) invalid #end #end">
	    <label class="element-label" for="$name">$label</label>
	    <div class="element-wrapper">
            <input type="radio" name="$name" value="0" #if($qcItem.getStringProperty($name) == "0")) checked #end />No
            <input type="radio" name="$name" value="1" #if($qcItem.getStringProperty($name) == "1")) checked #end />Yes
	    </div>
	    <div class="clear"></div>
	</div>
#end

#macro (qcCommentBox $name $qcItem $vr)
	<div class="panel-element #if($vr) #if($vr.getField($name)) invalid #end #end">
	    <label class="element-label" for="$name">Scan Comments</label>
	    <div class="element-wrapper">
            <textarea id="$name" name="$name" rows="6"></textarea>
	    </div>
	    <div class="clear"></div>
	</div>
#end


#if ($data.message)
	<div class="alert">$data.message</div>
#end

<link rel="stylesheet" type="text/css" href="$content.getURI("/style/fnirs.css")" />

<form ID="form1" name="form1" method="post" action="$link.setAction("ModifyManualQC")">
    <input type="hidden" name="project" value="$!{project}" >
    <input type="hidden" name="$item.getXSIType()/ID" id="$item.getXSIType()/ID" value=""/>
    #if($vr)
        <div class="error">Invalid parameters:<br />$vr.toHTML()</div>
    #end

    <h2>Edit fNIRS QC Assessment</h2>
    <table>
        <tr>
            <td>$displayManager.getSingularDisplayNameForProject()</td>
            <td>
                <div id="project_placeholder">$!om.getProjectDisplayID()</div>
            </td>
            #if($!om.getPass() && $turbineUtils.canDelete($user, $om.getItem()))
                <td>
                    <a onclick="modifyProject();"><i class="fa fa-edit" title="Edit Project"></i></a>
                    <input type="hidden" id="$om.getXSIType()/project" name="$om.getXSIType()/project" value="$!om.getProject()"/>
                    <script type="text/javascript">
                        function modifyProject(){
                            if(window.projectEditor==undefined){
                                var config =new Object();
                                if(window.currentID!=""){
                                    config.uri=XNAT.app.current_uri;
                                }
                                window.projectEditor=new ProjectEditor(config);
                                window.projectEditor.onModification.subscribe(function (obj){
                                    document.getElementById("project_placeholder").innerHTML=this.new_project_name;
                                    document.getElementById("$om.getXSIType()/project").value=this.new_project;
                                    XNAT.app.current_uri=serverRoot+"/REST/projects/" + this.new_project + "/subjects/$om.getImageSessionData().getSubjectId()/experiments/$om.getImageSessionData().getId()/assessors/$om.getId()";
                                    config.uri=XNAT.app.current_uri;
                                    confirmValues();
                                });
                                window.projectEditor.render();
                            }
                            window.projectEditor.panel.show();
                        }
                    </script>
                </td>
            #end
        </tr>
        <tr>
            <td>$displayManager.getSingularDisplayNameForImageSession() ID</td>
            <td>
                #set($imageSession_ID = $item.getStringProperty("fnirs:fnirsqcData/imageSession_ID"))
                #if ($imageSession_ID)
                    #set ($click = "$link.setAction('DisplayItemAction').addPathInfo('search_element',$imageSessionType).addPathInfo('search_field','xnat:imageSessionData.ID').addPathInfo('search_value',$imageSession_ID).addPathInfo('popup',$!popup).addPathInfo('project',$project)" )
                    <a href="$click">
                        $imageSession_ID
                    </a>
                    #xdatHiddenBox("fnirs:fnirsqcData/imageSession_ID" $item $imageSession_ID)
                #end

                #xdatHiddenBox("fnirs:fnirsqcData/project" $item $item.getStringProperty("fnirs:fnirsqcData/project"))

                #xdatHiddenBox("fnirs:fnirsqcData.ID" $item $item.getStringProperty("fnirs:fnirsqcData.ID"))
            </td>
        </tr>
        <tr><td>Label</td><td>#xdatStringBoxWClass("fnirs:fnirsqcData/label" $item "" $vr "required")</td></tr>
        <tr><td>QC Date</td>
            <td>
                <span id="qc-datepicker" class="single us today" data-default="" data-validate="onblur" data-input-id="fnirs:fnirsqcData/date" data-input-name="fnirs:fnirsqcData/date">
                <script type="text/javascript">
                    #if ($item.getProperty("fnirs:fnirsqcData/date"))
                        jQuery('#qc-datepicker').data('default','$item.getProperty("fnirs:fnirsqcData/date")');
                    #else
                        jQuery('#qc-datepicker').data('default',XNAT.data.todaysDate.us);
                    #end
                    XNAT.app.datePicker.init(jQuery('#qc-datepicker'));
                </script>
            </td>
        </tr>
        <tr><td>Rater</td><td>#xdatStringBox("fnirs:fnirsqcData/rater" $item "" $vr)</td></tr>
        <tr><td valign="top">Comments</td><td>#xdatTextArea("fnirs:fnirsqcData/comments" $item "" $vr 3 30)</td></tr>
    </table>

    #parse("/screens/EditProjectSpecificFields.vm")
    <br>
    <!-- BEGIN fnirs:fnirsqcData -->
    <script type="application/javascript" src="$content.getURI("/scripts/xnat/plugin/fnirs/fnirs-qc.js")"></script>
    <h2>Scans</h2>

    <!-- BEGIN fnirs:fnirsqcData/scans/scan -->
    #set($scans = $item.getChildItems("fnirs:fnirsqcData/scans/scan"))

    #if ($scans && $scans.size() > 0)
        #set($scan_counter = 0)
        #foreach($scan in $scans)
            #set($scanId = $scan.getProperty("imageScan_ID"))
            <div class="panel panel-default qcPanel $scanId">
                <div class="panel-heading">
                    <h3>$scanId</h3>
                </div>
                <div class="panel-body">
                    #parse($turbineUtils.getTemplateName("edit",$scan.getXSIType(),$project))
                </div>
            </div>
            #set($scan_counter = $scan_counter + 1)
        #end
    #end

    <!-- END fnirs:fnirsqcData/scans/scan -->
    <!-- END fnirs:fnirsqcData -->


    #if($item.getStringProperty("fnirs:fnirsqcData.ID"))
        #auditBoxes("3" "" "" "Modified Manual QC")
    #else
        #auditBoxes("3" "" "Standard QC" "Created Manual QC")
        #hideFormJustification()
    #end

    #xdatEditProps($item $edit_screen)
    <p><input type="submit" name="eventSubmit_doInsert" value="Submit"/></p>
</form>

<script type="text/javascript">
function validateForm()
{
   //INSERT CUSTOM CONTENT HERE

   validateExperimentForm();
   return false;
}
</script>
