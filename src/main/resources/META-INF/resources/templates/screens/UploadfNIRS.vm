<!-- BEGIN fnirs-plugin templates/screens/UploadfNIRS.vm -->
<div>
    <h2>fNIRS Scan Imaging Uploader</h2>

    <form id="upload-form" name="upload-form" method="post">

        <label for="project" class="project-label">$displayManager.getSingularDisplayNameForProject()</label>

        <section class="project-inputs">
            <select id="project" name="project" form="upload-form" required disabled>
                <option value="" disabled selected>Loading projects...</option>
            </select>
        </section>

        <label for="upload-type" class="upload-type-label">Upload Type</label>

        <section class="upload-type-section">
            <select id="upload-type" upload-type="type" form="upload-form" required>
                <option value="zip" selected>Zip File</option>
                <option value="folder">Uncompressed Folder</option>
            </select>
        </section>

        <p id="file-note">Upload zipped (.zip) set of subjects and their sessions to a specified project.</p>
        <p id="folder-note" style="display:none">Select a folder from your local filesystem to upload all of its contents to a specific project</p>

        <label class="file-label" for="file">File</label>
        <label class="folder-label" for="folder" style="display:none">Folder</label>

        <section class="file-inputs" id="file-section">
            <input type="file" id="file" name="file" accept="application/zip" required/>
        </section>

        <section class="folder-inputs" id="folder-section" style="display:none">
            <input type="file" id="folder" name="folder" webkitdirectory required/>
        </section>

        <input class="submit" id="uploadButton" type="button" name="eventSubmit_doPerform" value="Begin Upload" onclick="XNAT.plugin.fnirs.fnirsImporter.submitForm();"/>
    </form>
</div>

<style>
    .project-label { grid-area: project-label; }
    .project-inputs { grid-area: project-inputs; }

    #file-note, #folder-note{ grid-area: file-note; }

    .file-label { grid-area: file-label; }
    .file-inputs { grid-area: file-inputs; }

    .upload-type-label { grid-area: upload-type-label; }
    .upload-type-section { grid-area: upload-type-inputs; }
    .folder-inputs { grid-area: file-inputs; }

    .submit { grid-area: submit; }

    .project-label, .file-label, .folder-label, .upload-type-label {
        font-weight: bold;
    }

    #upload-form {
        width: 600px;
        display: grid;
        grid-template-columns: 100px 120px 380px;
        row-gap: 1em;
        grid-template-areas:
            'project-label project-inputs project-inputs'
            'upload-type-label upload-type-inputs upload-type-inputs'
            'file-note file-note file-note'
            'file-label file-inputs file-inputs'
            '. submit .'
    }
</style>

##<script type="text/javascript" src="$content.getURI('scripts/xnat/plugin/fnirs/fnirs-projects.js')"></script>
<script type="text/javascript" src="$content.getURI('scripts/xnat/plugin/fnirs/fNIRSUploader.js')"></script>

<!-- END fnirs-plugin templates/screens/UploadfNIRS.vm -->